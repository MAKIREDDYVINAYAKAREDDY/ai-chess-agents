","import chess.svg\n","import gym\n","import numpy as np\n","import random\n","from stable_baselines3 import PPO\n","from tqdm import tqdm"],"metadata":{"id":"767cOoNirhzA","executionInfo":{"status":"ok","timestamp":1741247271713,"user_tz":-330,"elapsed":26116,"user":{"displayName":"VINAYAKA REDDY","userId":"16168606088282616872"}}},"execution_count":5,"outputs":[]},{"cell_type":"code","source":["from gym import Env\n","from gym.spaces import Discrete, Box\n","\n","class ChessEnv(Env):\n","    def __init__(self, stockfish_path=\"/usr/games/stockfish\"):\n","        super().__init__()\n","        self.board = chess.Board()\n","        self.engine = chess.engine.SimpleEngine.popen_uci(stockfish_path)\n","        self.action_space = Discrete(4672)  # Max possible legal moves in chess\n","        self.observation_space = Box(low=0, high=1, shape=(8, 8, 12), dtype=np.uint8)\n","\n","    def reset(self):\n","        self.board.reset()\n","        return self.get_state()\n","\n","    def get_state(self):\n","        # Convert board to a tensor-like state representation\n","        state = np.zeros((8, 8, 12), dtype=np.uint8)\n","        piece_map = self.board.piece_map()\n","        for square, piece in piece_map.items():\n","            row, col = divmod(square, 8)\n","            state[row, col, piece.piece_type - 1] = 1  # 1-hot encode pieces\n","        return state\n","\n","    def step(self, action):\n","        legal_moves = list(self.board.legal_moves)\n","        if len(legal_moves) == 0:\n","            return self.get_state(), -1, True, {}\n","\n","        move = legal_moves[action % len(legal_moves)]\n","        self.board.push(move)\n","\n","        if self.board.is_checkmate():\n","            reward = 1  # AI wins\n","            done = True\n","        elif self.board.is_stalemate() or self.board.is_insufficient_material():\n","            reward = 0.5  # Draw\n","            done = True\n","        else:\n","            result = self.engine.play(self.board, chess.engine.Limit(time=0.1))\n","            self.board.push(result.move)\n","            done = self.board.is_game_over()\n","            reward = -1 if done and self.board.is_checkmate() else 0  # AI loses if checkmated\n","\n","        return self.get_state(), reward, done, {}\n","\n","    def render(self, mode=\"human\"):\n","        print(self.board)\n","\n","    def close(self):\n","        self.engine.quit()"],"metadata":{"id":"3hWkLF2TsCbi","executionInfo":{"status":"ok","timestamp":1741247283881,"user_tz":-330,"elapsed":5,"user":{"displayName":"VINAYAKA REDDY","userId":"16168606088282616872"}}},"execution_count":6,"outputs":[]},{"cell_type":"code","source":["env = ChessEnv()\n","from stable_baselines3 import PPO\n","model = PPO(\"MlpPolicy\", env, learning_rate=0.0001, n_steps=2048, batch_size=64, verbose=1)\n","model.learn(total_timesteps=50000)  # Add more steps\n","model.save(\"chess_ai_agent.h5\")    # Save the updated version"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"qpLgoiZvsKtJ","outputId":"f9110906-6037-4944-b036-9603a959855e","executionInfo":{"status":"ok","timestamp":1741252283475,"user_tz":-330,"elapsed":4995456,"user":{"displayName":"VINAYAKA REDDY","userId":"16168606088282616872"}}},"execution_count":7,"outputs":[{"output_type":"stream","name":"stdout","text":["Using cpu device\n","Wrapping the env with a `Monitor` wrapper\n","Wrapping the env in a DummyVecEnv.\n"]},{"output_type":"stream","name":"stderr","text":["/usr/local/lib/python3.11/dist-packages/stable_baselines3/common/vec_env/patch_gym.py:49: UserWarning: You provided an OpenAI Gym environment. We strongly recommend transitioning to Gymnasium environments. Stable-Baselines3 is automatically wrapping your environments in a compatibility layer, which could potentially cause issues.\n","  warnings.warn(\n"]},{"output_type":"stream","name":"stdout","text":["---------------------------------\n","| rollout/           |          |\n","|    ep_len_mean     | 13.9 