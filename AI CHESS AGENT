 . . . . . . .\n",". . . . p . . P\n","P . . . p . . .\n",". P . K . . . .\n",". . . b . P P n\n","q . B . . B N .\n","r n b q k . . r\n","p p . . . . p p\n",". . . . . . . .\n",". . . . p p . P\n","P . . . K . . .\n",". P . . . . . .\n",". . . b . P P n\n","q . B . . B N .\n"]}]},{"cell_type":"code","source":["import chess\n","import chess.engine\n","import numpy as np\n","from gym import Env\n","from gym.spaces import Discrete, Box\n","\n","class ChessEnv(Env):\n","    def __init__(self, stockfish_path=\"/usr/games/stockfish\", stockfish_level=10):\n","        super().__init__()\n","        self.board = chess.Board()\n","        self.engine = chess.engine.SimpleEngine.popen_uci(stockfish_path)\n","        self.engine.configure({\"Skill Level\": stockfish_level})  # Adjustable Stockfish strength\n","        self.action_space = Discrete(4672)  # Max legal moves in any position\n","        self.observation_space = Box(low=0, high=1, shape=(8, 8, 12), dtype=np.uint8)\n","        self.max_moves = 100  # Prevent infinite games\n","\n","    def reset(self):\n","        \"\"\"Reset the board to the initial position and return the initial state.\"\"\"\n","        self.board.reset()\n","        self.move_count = 0\n","        return self._get_state()\n","\n","    def _get_state(self):\n","        \"\"\"Convert the board to an 8x8x12 tensor representing pieces for both colors.\"\"\"\n","        state = np.zeros((8, 8, 12), dtype=np.uint8)\n","        for square, piece in self.board.piece_map().items():\n","            rank = 7 - chess.square_rank(square)  # Flip for white's perspective\n","            file = chess.square_file(square)\n","            # 0-5: White pieces (pawn, knight, bishop, rook, queen, king)\n","            # 6-11: Black pieces (pawn, knight, bishop, rook, queen, king)\n","            color_offset = 0 if piece.color == chess.WHITE else 6\n","            piece_idx = piece.piece_type - 1  # 0-based index (pawn=0, king=5)\n","            state[rank, file, color_offset + piece_idx] = 1\n","        return state\n","\n","    def step(self, action):\n","        \"\"\"Take an action (move), update the board, and return (state, reward, done, info).\"\"\"\n","        legal_moves = list(self.board.legal_moves)\n","\n","        # Handle no legal moves (shouldn't happen in normal chess)\n","        if not legal_moves:\n","            return self._get_state(), -1, True, {\"reason\": \"no_legal_moves\"}\n","\n","        # Map action to a legal move\n","        move = legal_moves[action % len(legal_moves)]\n","        self.board.push(move)\n","        self.move_count += 1\n","\n","        # Check game outcome after AI's move\n","        if self.board.is_checkmate():\n","            reward = 1.0  # Win\n","            done = True\n","        elif self.board.is_stalemate() or self.board.is_insufficient_material():\n","            reward = 0.0  # Draw\n","            done = True\n","        elif self.move_count >= self.max_moves:\n","            reward = 0.0  # Draw by max moves\n","            done = True\n","        else:\n","            # Stockfish's turn\n","            result = self.engine.play(self.board, chess.engine.Limit(time=0.1))\n","            self.board.push(result.move)\n","            self.move_count += 1\n","\n","            # Check game outcome after Stockfish's move\n","            if self.board.is_checkmate():\n","                reward = -1.0  # Loss\n","                done = True\n","            elif self.board.is_stalemate() or self.board.is_insufficient_material():\n","                reward = 0.0  # Draw\n","                done = True\n","            elif self.move_count >= self.max_moves:\n","                reward = 0.0  # Draw by max moves\n","                done = True\n","            else:\n","                reward = 0.0  # Game continues\n","                done = False\n","\n","        return self._get_state(), reward, done, {\"move\": str(move)}\n","\n","    def render(self, mode=\"human\"):\n","        \"\"\"Display the current board state.\"\"\"\n","        if mode == \"human\":\n","            print(self.board)\n","        else:\n","            raise NotImplementedError(\"Only human mode is supported\")\n","\n","    def close(self):\n","        \"\"\"Clean up the Stockfish engine.\"\"\"\n","        if self.engine:\n","            self.engine.quit()\n","\n","    def legal_moves_mask(self):\n","        \"\"\"Return a mask of valid actions (1 for legal, 0 for illegal).\"\"\"\n","        mask = np.zeros(self.action_space.n, dtype=np.uint8)\n","        legal_moves = list(self.board.legal_moves)\n","        for i in range(len(legal_moves)):\n","            mask[i] = 1\n","        return mask"],"metadata":{"id":"_WbEfCsMT5L1","executionInfo":{"status":"ok","timestamp":1741252305965,"user_tz":-330,"elapsed":360,"user":{"displayName":"VINAYAKA REDDY","userId":"16168606088282616872"}}},"execution_count":13,"outputs":[]},{"cell_type":"code","source":["from IPython.display import display, SVG\n","import time\n","\n","def play_stockfish_with_svg(model, stockfish_path=\"/usr/games/stockfish\"):\n","    env = ChessEnv(stockfish_path)\n","    obs = env.reset()\n","    done = False\n","    while not done:\n","        display(SVG(chess.svg.board(board=env.board, size=500)))\n","        action, _states = model.predict(obs)\n","        obs, reward, done, _ = env.step(action)\n","        time.sleep(1)  # Slow down for visibility\n","    env.close()\n","\n","play_stockfish_with_svg(model)"],"metadata":{"id":"ed2OtpAeytvM","executionInfo":{"status":"ok","timestamp":1741252330323,"user_tz":-330,"elapsed":21359,"user":{"displayName":"VINAYAKA REDDY","userId":"16168606088282616872"}},"colab":{"base_uri":"https://localhost:8080/","height":1000},"outputId":"dd60aa55-020f-4d18-b816-5d07c8970bde"},"execution_count":14,"outputs":[{"output_type":"display_data","data":{"text/plain":["<IPython.core.display.SVG object>"],"image/svg+xml":"<svg xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=